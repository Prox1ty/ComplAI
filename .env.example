# ---- LLM -------------------------------------------------------------
# groq (free tier), openai (any OpenAI-compatible endpoint) or anthropic
LLM_PROVIDER=groq
GROQ_API_KEY=
SMALL_MODEL=openai/gpt-oss-20b
LARGE_MODEL=openai/gpt-oss-120b
# gpt-oss "thinking" effort: low keeps it from eating the output budget
REASONING_EFFORT=low
# Your provider limits; the budgeter applies 80% of these (Groq free tier: ~8K TPM, 30 RPM).
LLM_TPM_LIMIT=8000
LLM_RPM_LIMIT=30
LLM_CONCURRENCY=3

# Other providers:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# SMALL_MODEL=claude-haiku-5-5
# LARGE_MODEL=claude-sonnet-5-5
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Per-run ceiling; reduced mode kicks in at 80%.
RUN_TOKEN_CEILING=150000
LLM_CACHE=1

# ---- Web search ------------------------------------------------------
# Tavily is preferred; DuckDuckGo is used when this is empty or Tavily fails.
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=1

# ---- Retrieval -------------------------------------------------------
EMBED_BACKEND=st
EMBED_MODEL=intfloat/multilingual-e5-small
# sqlite = SQLite + sqlite-vec index (falls back to exact numpy search if the extension cannot load)
VECTOR_BACKEND=sqlite
# Pass B similarity thresholds (cosine, E5): >= high is "met" without an LLM call,
# < low is a missing candidate, the band in between goes to the LLM.
COVERAGE_HIGH=0.88
COVERAGE_LOW=0.80

# ---- App -------------------------------------------------------------
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=10
# 1 = skip the real pipeline and replay frontend/mock/result.json (UI demo against the real API)
FAKE_PIPELINE=0
